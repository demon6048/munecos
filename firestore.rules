rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // Datos internos: solo administradores (leer y escribir).
    match /{coll}/{id} {
      allow read, write: if isAdmin() && coll in ['clientes','eventos','cotizaciones','contratos','pagos','gastos','personal','inventario','config','oportunidades','suscriptores','testimonios'];
    }
    // Cotizaciones del formulario público: el público solo puede CREAR (con validación).
    match /oportunidades/{id} {
      allow create: if request.resource.data.keys().hasOnly(['nombre','tel','correo','tipo','fecha','hora','ciudad','local','asist','formato','msg','creado','estado'])
        && request.resource.data.nombre is string && request.resource.data.nombre.size() > 0 && request.resource.data.nombre.size() <= 120
        && request.resource.data.tel is string && request.resource.data.tel.size() > 0 && request.resource.data.tel.size() <= 20
        && request.resource.data.tipo is string && request.resource.data.tipo.size() <= 40
        && request.resource.data.ciudad is string && request.resource.data.ciudad.size() <= 120
        && request.resource.data.msg is string && request.resource.data.msg.size() <= 1000
        && request.resource.data.estado == 'nueva'
        && request.resource.data.creado == request.time;
    }
    // Agenda pública: solo eventos marcados como públicos por administración.
    match /eventos/{id} {
      allow get, list: if resource.data.vis == 'Público';
    }
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
